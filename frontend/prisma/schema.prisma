generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Signal {
  id         String   @id @default(cuid())
  title      String
  type       String
  location   String?
  score      Int
  confidence Float
  date       DateTime
  createdAt  DateTime @default(now())
}
