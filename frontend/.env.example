# Copy to .env for local dev.
# SQLite file is created next to prisma/schema.prisma when you run: npx prisma db push
DATABASE_URL="file:./dev.db"

# Vercel / production: use a hosted Postgres URL (Neon, Supabase, PlanetScale, etc.),
# switch datasource provider in prisma/schema.prisma to "postgresql", then prisma migrate.
