{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/ingest/fetch",
      "schedule": "0 */3 * * *"
    },
    {
      "path": "/api/ingest/process",
      "schedule": "15 */3 * * *"
    },
    {
      "path": "/api/internal/signals/process",
      "schedule": "0 */6 * * *"
    }
  ]
}
