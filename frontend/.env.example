# Required for Prisma (Signal, Deal, Outcome). Example for local SQLite:
# DATABASE_URL="file:./prisma/dev.db"

# Optional — protects POST /api/planning-intelligence, POST /api/deals, POST /api/outcome, outcomes, GET /api/feedback/accuracy, GET /api/internal/planning-intelligence, and /internal (use ?t=).
# Send: Authorization: Bearer <same value>  OR  X-Internal-Key: <same value>
# Leave unset for local demo (open /api/ingest and open POST /api/planning-intelligence).
# INTERNAL_API_SECRET=

# Optional — if PlanSureAI runs on another origin, set to that origin for CORS on POST /api/planning-intelligence.
# PLANNING_INTELLIGENCE_CORS_ORIGIN=https://app.plansure.example
